#!/bin/zsh
set -euo pipefail

if [[ "${1:-}" == "--preset-import-gui" && "${2:-}" == "--preset-list" ]]; then
  print -r -- "    1080 原帧率 硬件加速"
  exit 0
fi

output=""
while (( $# > 0 )); do
  case "$1" in
    -o)
      output="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[[ -n "$output" ]] || exit 2
print -r -- "fake compressed" > "$output"
