#!/bin/zsh
set -euo pipefail

if [[ "${1:-}" == "--preset-list" || ( "${1:-}" == "--preset-import-gui" && "${2:-}" == "--preset-list" ) ]]; then
  print -r -- "    Fast 1080p30"
  print -r -- "    1080 原帧率 硬件加速"
  exit 0
fi

input=""
output=""
while (( $# > 0 )); do
  case "$1" in
    -i)
      input="$2"
      shift 2
      ;;
    -o)
      output="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[[ -n "$output" ]] || exit 2

if [[ -n "${FAKE_HANDBRAKE_ORDER_LOG:-}" ]]; then
  print -r -- "${input:t}" >> "$FAKE_HANDBRAKE_ORDER_LOG"
fi
if [[ -n "${FAKE_HANDBRAKE_CALLS:-}" ]]; then
  printf '%s\0' "$input" >> "$FAKE_HANDBRAKE_CALLS"
fi

# Model the partial output left behind by a real failed/interrupted encoder.
print -r -- "partial" > "$output"

for percentage in 0 25 50 75 100; do
  printf 'Encoding: task 1 of 1, %.2f %%\r' "$percentage"
  if (( percentage < 100 )) && [[ "${FAKE_HANDBRAKE_STEP_DELAY:-0}" != "0" ]]; then
    /bin/sleep "$FAKE_HANDBRAKE_STEP_DELAY"
  fi
done
print

if [[ -n "${FAKE_HANDBRAKE_FAIL_PATTERN:-}" && "${input:t}" == ${~FAKE_HANDBRAKE_FAIL_PATTERN} ]]; then
  exit 1
fi

if [[ "${FAKE_HANDBRAKE_EMPTY_SUCCESS:-0}" == 1 ]]; then
  : > "$output"
else
  print -r -- "fake compressed: ${input:t}" > "$output"
fi
